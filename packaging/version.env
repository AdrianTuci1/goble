# Single source of truth for product identity across every packaging script.
# Sourced (not executed) by the make-* scripts and by scripts/release.sh.
# Keep it POSIX-compatible: only KEY="value" lines.
#
# Version precedence at release time is:
#   --version argument > $GOBLE_VERSION > `git describe --tags` > VERSION below.

# Human-readable product name. Used for window/menu titles, DMG volume name and
# the Windows installer display name.
APP_NAME="Goble"

# Lowercase slug used for on-disk paths, the Linux package name and temp dirs.
APP_SLUG="goble"

# Cargo package/binary name produced by the `app/` crate.
PKG_NAME="goble-app"
BIN_NAME="goble-app"

# Reverse-DNS identifier: CFBundleIdentifier (macOS) and Windows AppId source.
BUNDLE_ID="com.goble.app"

# Fallback version. The Cargo manifest version is authoritative for a plain
# `cargo build`; this value is only used when no tag/env/argument is available.
VERSION="0.1.0"

# Maintainer string required by dpkg-deb and referenced by the Inno Setup script.
MAINTAINER="Goble Contributors <dev@goble.app>"

# Default release host for `dist/channel_versions.json` artifact links.
# scripts/release.sh joins this with "/v<resolved-version>/<file>". Override the
# whole thing with GOBLE_DOWNLOAD_BASE when artifacts live elsewhere. It must be
# an absolute https base; the updater resolves manifest URLs verbatim.
RELEASE_BASE_URL="https://github.com/AdrianTuci1/goble/releases/download"
