{
  "$metadata": {
    "$name": "goble",
    "$description": "Goble design tokens — dark, light and midnight themes with density, radius and typography scales. Import into Penpot via the Tokens panel."
  },
  "theme": {
    "$description": "Semantic theme tokens",
    "dark": {
      "bg": { "$value": "#0e0e0e", "$type": "color" },
      "surface": { "$value": "#161616", "$type": "color" },
      "surface-raised": { "$value": "#1e1e1e", "$type": "color" },
      "border": { "$value": "#262626", "$type": "color" },
      "text": { "$value": "#e8e8e8", "$type": "color" },
      "muted": { "$value": "#8e8e8e", "$type": "color" },
      "accent": { "$value": "#9a9a9a", "$type": "color" },
      "hover": { "$value": "#1e1e1e", "$type": "color" },
      "selected": { "$value": "#2a2a2a", "$type": "color" }
    },
    "light": {
      "bg": { "$value": "#f5f5f5", "$type": "color" },
      "surface": { "$value": "#ffffff", "$type": "color" },
      "surface-raised": { "$value": "#f0f0f0", "$type": "color" },
      "border": { "$value": "#e0e0e0", "$type": "color" },
      "text": { "$value": "#1f1f1f", "$type": "color" },
      "muted": { "$value": "#6f6f6f", "$type": "color" },
      "accent": { "$value": "#9a9a9a", "$type": "color" },
      "hover": { "$value": "#f0f0f0", "$type": "color" },
      "selected": { "$value": "#e2e2e2", "$type": "color" }
    },
    "midnight": {
      "bg": { "$value": "#0a0a0a", "$type": "color" },
      "surface": { "$value": "#121212", "$type": "color" },
      "surface-raised": { "$value": "#191919", "$type": "color" },
      "border": { "$value": "#212121", "$type": "color" },
      "text": { "$value": "#eaeaea", "$type": "color" },
      "muted": { "$value": "#6f6f6f", "$type": "color" },
      "accent": { "$value": "#9a9a9a", "$type": "color" },
      "hover": { "$value": "#191919", "$type": "color" },
      "selected": { "$value": "#222222", "$type": "color" }
    }
  },
  "accent": {
    "$description": "Accent color options",
    "blue": { "$value": "#9a9a9a", "$type": "color" },
    "green": { "$value": "#10b981", "$type": "color" },
    "purple": { "$value": "#8b5cf6", "$type": "color" },
    "orange": { "$value": "#f97316", "$type": "color" }
  },
  "status": {
    "$description": "Status / semantic colors",
    "success": { "$value": "#10b981", "$type": "color" },
    "warning": { "$value": "#f59e0b", "$type": "color" },
    "error": { "$value": "#ef4444", "$type": "color" },
    "badge": { "$value": "#e01e5a", "$type": "color" }
  },
  "dimension": {
    "spacing": {
      "$description": "Base spacing scale",
      "xs": { "$value": "4px", "$type": "dimension" },
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "12px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" }
    },
    "radius": {
      "$description": "Corner radius scale",
      "sharp": { "$value": "0px", "$type": "dimension" },
      "default": { "$value": "8px", "$type": "dimension" },
      "rounded": { "$value": "14px", "$type": "dimension" }
    }
  },
  "number": {
    "density": {
      "$description": "Density multipliers applied to spacing and component sizing",
      "compact": { "$value": 0.85, "$type": "number" },
      "default": { "$value": 1, "$type": "number" },
      "spacious": { "$value": 1.15, "$type": "number" }
    }
  },
  "fontFamily": {
    "system": { "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$type": "fontFamily" },
    "serif": { "$value": "Georgia, Cambria, 'Times New Roman', Times, serif", "$type": "fontFamily" }
  },
  "fontSize": {
    "xs": { "$value": "11px", "$type": "fontSize" },
    "sm": { "$value": "12px", "$type": "fontSize" },
    "base": { "$value": "14px", "$type": "fontSize" },
    "md": { "$value": "15px", "$type": "fontSize" },
    "lg": { "$value": "18px", "$type": "fontSize" },
    "xl": { "$value": "24px", "$type": "fontSize" }
  },
  "fontWeight": {
    "regular": { "$value": 400, "$type": "fontWeight" },
    "medium": { "$value": 500, "$type": "fontWeight" },
    "semibold": { "$value": 600, "$type": "fontWeight" },
    "bold": { "$value": 700, "$type": "fontWeight" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(0,0,0,0.15)", "$type": "shadow" },
    "md": { "$value": "0 4px 12px rgba(0,0,0,0.25)", "$type": "shadow" }
  }
}
